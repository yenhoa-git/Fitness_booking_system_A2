  "item": [
    {
      "name": "FR03 - View members list",
      "item": [
        {
          "name": "Step - Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Parse the response body",
                  "let response = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is present\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "pm.test(\"Body matches string\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"admin\");",
                  "});",
                  "",
                  "// Save JWT token to environment variable",
                  "if (response.token) {",
                  "    pm.environment.set(\"jwt_token\", response.token);",
                  "    console.log(\"jwt_token saved to environment\");",
                  "} else {",
                  "    console.warn(\"No token found in response!\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Tutorial 10 Step 3B: login and save jwt_token (admin)."
          },
          "response": []
        },
        {
          "name": "Step - Get classes (save class_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let response = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is present\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "pm.test(\"At least one class exists\", function () {",
                  "    pm.expect(response.length).to.be.above(0);",
                  "});",
                  "",
                  "// Save the first class id to the environment",
                  "if (response.length) {",
                  "    pm.environment.set(\"class_id\", response[0]._id);",
                  "    console.log(\"class_id saved to environment\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/classes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "classes"
              ]
            },
            "description": "Tutorial 10 Step 3C: GET with Authorization: Bearer {{jwt_token}}."
          },
          "response": []
        },
        {
          "name": "FR03 - Admin gets members list (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let response = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is present\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "pm.test(\"Body matches string\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"members\");",
                  "});",
                  "pm.test(\"Response has title, memberCount and members\", function () {",
                  "    pm.expect(response).to.have.property(\"title\");",
                  "    pm.expect(response.memberCount).to.be.a(\"number\");",
                  "    pm.expect(response.members).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Members show name and email only (no password)\", function () {",
                  "    response.members.forEach(function (member) {",
                  "        pm.expect(member).to.have.property(\"name\");",
                  "        pm.expect(member).to.have.property(\"email\");",
                  "        pm.expect(member).to.not.have.property(\"password\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/classes/{{class_id}}/members",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "classes",
                "{{class_id}}",
                "members"
              ]
            },
            "description": "FR03: admin can view the members of a class."
          },
          "response": []
        },
